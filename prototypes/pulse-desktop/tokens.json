    "botLight": { "$type": "color", "$value": "#E5FFF1" },
    "surface": {
      "$type": "color",
      "$value": "#FFFFFF"
    },
    "canvas": {
      "$type": "color",
      "$value": "#F5F7F6"
    },
    "ink": {
      "$type": "color",
      "$value": "#24352F"
    },
    "muted": {
      "$type": "color",
      "$value": "#5D6D66"
    },
    "line": {
      "$type": "color",
      "$value": "#DBE4DE"
    },
    "track": {
      "$type": "color",
      "$value": "#E8EFEB"
    },
    "green": {
      "$type": "color",
      "$value": "#23815C"
