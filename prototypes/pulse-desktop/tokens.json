    },
    "greenSoft": {
      "$type": "color",
      "$value": "#EBF5EE"
    },
    "amber": {
      "$type": "color",
      "$value": "#9B641B"
    },
    "amberSoft": {
      "$type": "color",
      "$value": "#FFF4DF"
    },
    "red": {
      "$type": "color",
      "$value": "#B64A49"
    },
    "redSoft": {
      "$type": "color",
      "$value": "#FFF0EE"
    },
    "focus": {
      "$type": "color",
      "$value": "#247AAB"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": "\"Segoe UI Variable\", \"Segoe UI\", \"Microsoft YaHei UI\", sans-serif"
    },
    "body": {
      "$type": "dimension",
      "$value": "13px"
    },
    "caption": {
      "$type": "dimension",
      "$value": "12px"
    }
  },
  "shape": {
    "card": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "size": {
    "ring": {
      "$type": "dimension",
      "$value": "42px"
    },
    "control": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "space": {
    "inset": {
      "$type": "dimension",
      "$value": "20px"
    }
  },
  "motion": {
    "enter": {
      "$type": "duration",
      "$value": "180ms"
    },
    "exit": {
      "$type": "duration",
      "$value": "120ms"
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.23,
        1,
        0.32,
        1
      ]
    }
  },
  "elevation": {
    "shadow": {
      "$type": "string",
      "$value": "0 8px 28px -8px rgba(27, 45, 36, 0.18), 0 1px 3px rgba(27, 45, 36, 0.06)"
    }
